# Copy this file to .env.local and fill in the two values.
#
# In the class: your teacher gives you both values.
# With your own Supabase project: Dashboard → Project Settings → API.
#
# Without these values the app starts in mock mode (no server, no AI).

# Project URL: replace YOUR-PROJECT-REF with the project reference id.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable key ("sb_publishable_..."; older projects call it the anon key).
# It is safe for the browser: Row Level Security protects the data.
VITE_SUPABASE_ANON_KEY=
